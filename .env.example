# Used by app/sitemap.ts and app/robots.ts to generate absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional (enables Spotify terminal commands + "Now Playing" widget).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional (enables WakaTime stats).
WAKATIME_API_KEY=

# Optional (enables GitHub contributions stats via GraphQL).
GITHUB_TOKEN=

# Optional (enables analytics + guestbook via Supabase).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt used to hash visitor IPs before storage (analytics + guestbook).
# Set a random value in production so raw IPs are never persisted.
APP_IP_SALT=

# Optional (enables Guestbook API).
# false => new entries are stored as pending moderation.
GUESTBOOK_AUTO_APPROVE=true
# Per-IP hashed rate limit window (max posts/hour).
GUESTBOOK_RATE_LIMIT_MAX_PER_HOUR=3

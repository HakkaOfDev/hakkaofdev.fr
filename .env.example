# Used by app/sitemap.ts and app/robots.ts to generate absolute URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional (enables Spotify terminal commands + "Now Playing" widget).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional (enables WakaTime stats).
WAKATIME_API_KEY=

# Optional (enables GitHub contributions stats via GraphQL).
GITHUB_TOKEN=

# Optional (enables page view counter via Supabase).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
